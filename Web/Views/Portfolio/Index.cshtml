@model List<Web.Models.PortfolioSummary>

<h2>Welcome, @ViewBag.UserEmail</h2>

<a asp-action="Create" class="btn btn-primary mb-3">+ New Portfolio</a>

@if (Model == null || !Model.Any())
{
    <p>You don't have any portfolios yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var portfolio in Model)
        {
            <li class="list-group-item">
                <a asp-action="Details" asp-route-id="@portfolio.Id">@portfolio.Name</a>
            </li>
        }
    </ul>
}

<form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
    <button type="submit" class="btn btn-secondary">Log Out</button>
</form>