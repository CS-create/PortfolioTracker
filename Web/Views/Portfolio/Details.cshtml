@model Web.Models.PortfolioDetail

<h2>@Model.Name</h2>

<div class="portfolio-summary">
    <div>
        <div class="stat-label">Total Value</div>
        <div class="stat-value">@Model.TotalValue.ToString("N2")</div>
    </div>
    <div>
        <div class="stat-label">Total Gain/Loss</div>
        <div class="stat-value @(Model.TotalGainLoss >= 0 ? "positive" : "negative")">
            @(Model.TotalGainLoss >= 0 ? "+" : "")@Model.TotalGainLoss.ToString("N2")
        </div>
    </div>
</div>

<div class="mb-3">
    <a asp-action="AddHolding" asp-route-portfolioId="@Model.Id" class="btn btn-primary">+ Add Holding</a>
    <a asp-action="AddTransaction" asp-route-portfolioId="@Model.Id" class="btn btn-primary">+ Record Transaction</a>
</div>

@if (!Model.Holdings.Any())
{
    <p class="text-muted">No holdings yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Symbol</th>
                <th>Quantity</th>
                <th>Avg Cost</th>
                <th>Current Price</th>
                <th>Market Value</th>
                <th>Gain/Loss</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var holding in Model.Holdings)
            {
                <tr>
                    <td><span class="symbol-badge">@holding.Symbol</span></td>
                    <td class="mono">@holding.Quantity.ToString("N4")</td>
                    <td class="mono">@holding.AverageCostBasis.ToString("N2") @holding.Currency</td>
                    <td class="mono">@holding.CurrentPrice.ToString("N2") @holding.Currency</td>
                    <td class="mono">@holding.MarketValue.ToString("N2") @holding.Currency</td>
                    <td class="mono @(holding.UnrealizedGainLoss >= 0 ? "gain" : "loss")">
                        @(holding.UnrealizedGainLoss >= 0 ? "+" : "")@holding.UnrealizedGainLoss.ToString("N2") @holding.Currency
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index">← Back to portfolios</a>